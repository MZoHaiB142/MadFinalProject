<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Wahi pehli file wala Gradient Background -->
    <gradient
        android:angle="315"
        android:startColor="#281A4A"
        android:endColor="#0F3866"
        android:type="linear"/>

    <!-- Wahi pehli file wala Border (Stroke) -->
    <stroke
        android:width="1dp"
        android:color="#22C4D6"/>

    <!-- Corners aapke original size ke mutabiq -->
    <corners android:radius="16dp"/>

</shape>