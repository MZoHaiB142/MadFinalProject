<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FAFBFE" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <RelativeLayout android:layout_width="match_parent" android:layout_height="60dp" android:paddingLeft="8dp" android:paddingRight="12dp">
   <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:layout_centerVertical="true" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_arrow_back"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="IELTS Academic - Preparation" android:textColor="#071A48" android:textSize="16sp" android:textStyle="bold"/>
   <TextView android:layout_width="38dp" android:layout_height="38dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:gravity="center" android:text="♧" android:textColor="#071A48" android:textSize="22sp"/>
   <TextView android:layout_width="17dp" android:layout_height="17dp" android:layout_alignParentEnd="true" android:layout_marginTop="7dp" android:background="@drawable/bg_badge_red" android:gravity="center" android:text="3" android:textColor="#FFFFFF" android:textSize="9sp"/>
  </RelativeLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp">
   <TextView android:id="@+id/tabOverview" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Overview" android:textColor="#E91F32" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/tabLessons" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Lessons" android:textColor="#52617C" android:textSize="12sp"/><TextView android:id="@+id/tabPractice" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Practice" android:textColor="#52617C" android:textSize="12sp"/><TextView android:id="@+id/tabMockTests" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Mock Tests" android:textColor="#52617C" android:textSize="12sp"/><TextView android:id="@+id/tabReports" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Reports" android:textColor="#52617C" android:textSize="12sp"/>
  </LinearLayout>
  <View android:layout_width="76dp" android:layout_height="3dp" android:background="#E91F32"/>

  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="132dp" android:background="@drawable/bg_score_pink" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Target Band Score" android:textColor="#071A48" android:textSize="14sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="7.5" android:textColor="#E91F32" android:textSize="32sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="You're aiming high! Keep going 🚀" android:textColor="#52617C" android:textSize="12sp"/></LinearLayout>
    <LinearLayout android:layout_width="80dp" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/btnEditScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="7dp" android:text="✎ Edit" android:textColor="#E91F32" android:textSize="12sp"/><TextView android:layout_width="70dp" android:layout_height="70dp" android:gravity="center" android:text="🎯" android:textSize="50sp"/></LinearLayout>
   </LinearLayout>

   <LinearLayout android:layout_width="match_parent" android:layout_height="105dp" android:layout_marginTop="12dp" android:background="@drawable/bg_test_card" android:gravity="center" android:orientation="horizontal">
    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="🗓️\nStudy Plan" android:textColor="#071A48" android:textSize="11sp"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="❓\nPractice\nQuestions" android:textColor="#071A48" android:textSize="11sp"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▣\nMock Tests" android:textColor="#071A48" android:textSize="11sp"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="✎\nAI Writing\nChecker" android:textColor="#071A48" android:textSize="11sp"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="🎙\nAI Speaking\nPractice" android:textColor="#071A48" android:textSize="11sp"/>
   </LinearLayout>

   <TextView style="@style/PrepSectionTitle" android:text="Continue Learning                                            View All"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="110dp" android:background="@drawable/bg_continue_pink" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp"><TextView android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="🎧" android:textSize="24sp"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Listening • Section 1" android:textColor="#071A48" android:textSize="13sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Introduction to the test &amp; tips" android:textColor="#52617C" android:textSize="11sp"/><ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp" android:max="100" android:progress="65" android:progressDrawable="@drawable/bg_progress_red"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="65% Completed" android:textColor="#E91F32" android:textSize="10sp"/></LinearLayout><Button android:id="@+id/btnContinue" android:layout_width="90dp" android:layout_height="44dp" android:layout_marginStart="12dp" android:background="@drawable/bg_red_button" android:text="Continue" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="11sp"/></LinearLayout>

   <TextView style="@style/PrepSectionTitle" android:text="Study Plan (Today)                                         View Plan"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_test_card" android:orientation="vertical">
    <LinearLayout style="@style/PrepPlanRow"><TextView style="@style/PrepPlanIcon" android:text="🎧"/><TextView style="@style/PrepPlanText" android:text="Listening Practice\n2 Sets • 30 Questions"/><TextView android:layout_width="55dp" android:layout_height="wrap_content" android:text="◷ 30 Min   ○" android:textColor="#52617C" android:textSize="9sp"/></LinearLayout>
    <LinearLayout style="@style/PrepPlanRow"><TextView style="@style/PrepPlanIcon" android:text="📖"/><TextView style="@style/PrepPlanText" android:text="Reading Practice\n1 Set • 13 Questions"/><TextView android:layout_width="55dp" android:layout_height="wrap_content" android:text="◷ 20 Min   ○" android:textColor="#52617C" android:textSize="9sp"/></LinearLayout>
    <LinearLayout style="@style/PrepPlanRow"><TextView style="@style/PrepPlanIcon" android:text="Aa" android:textColor="#7046E8"/><TextView style="@style/PrepPlanText" android:text="Vocabulary Session\nLearn 20 new words"/><TextView android:layout_width="55dp" android:layout_height="wrap_content" android:text="◷ 15 Min   ○" android:textColor="#52617C" android:textSize="9sp"/></LinearLayout>
    <LinearLayout style="@style/PrepPlanRow"><TextView style="@style/PrepPlanIcon" android:text="✎"/><TextView style="@style/PrepPlanText" android:text="Writing Task 2\nEssay Practice"/><TextView android:layout_width="55dp" android:layout_height="wrap_content" android:text="◷ 30 Min   ○" android:textColor="#52617C" android:textSize="9sp"/></LinearLayout>
    <LinearLayout style="@style/PrepPlanRow"><TextView style="@style/PrepPlanIcon" android:text="🎙"/><TextView style="@style/PrepPlanText" android:text="Speaking Part 2\nCue Card Practice"/><TextView android:layout_width="55dp" android:layout_height="wrap_content" android:text="◷ 15 Min   ○" android:textColor="#52617C" android:textSize="9sp"/></LinearLayout>
   </LinearLayout>

   <TextView style="@style/PrepSectionTitle" android:text="Recent Mock Test                                             View All"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="125dp" android:background="@drawable/bg_test_card" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▣   IELTS Academic Mock Test 1                         Overall Band\n     Tested on 18 May 2024                                      6.5" android:textColor="#071A48" android:textSize="12sp" android:textStyle="bold"/><View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="#EDF1F7"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Listening                 Reading                 Writing                 Speaking\n    6.5                         6.5                       6.0                         6.5" android:textColor="#52617C" android:textSize="11sp"/></LinearLayout>

   <TextView style="@style/PrepSectionTitle" android:text="Top Tips for You                                             View All"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:layout_marginBottom="20dp" android:background="@drawable/bg_test_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp"><TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_badge_soft_blue" android:gravity="center" android:text="💡" android:textSize="22sp"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Tip of the Day\nManage your time in Reading. Don't spend more than 20 minutes on any passage." android:textColor="#52617C" android:textSize="11sp"/><TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="›" android:textColor="#071A48" android:textSize="25sp"/></LinearLayout>
  </LinearLayout>
 </LinearLayout>
</ScrollView>
