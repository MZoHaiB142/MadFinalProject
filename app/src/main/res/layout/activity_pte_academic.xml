<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8FAFE" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <RelativeLayout android:layout_width="match_parent" android:layout_height="52dp">
   <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:layout_centerVertical="true" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_arrow_back"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="PTE Academic" android:textColor="#071A48" android:textSize="19sp" android:textStyle="bold"/>
   <ImageButton android:id="@+id/btnFavorite" android:layout_width="44dp" android:layout_height="44dp" android:layout_alignParentEnd="true" android:background="?attr/selectableItemBackgroundBorderless" android:padding="11dp" android:src="@drawable/heart"/>
  </RelativeLayout>

  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_pte_teal" android:orientation="vertical" android:padding="22dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:layout_width="90dp" android:layout_height="90dp" android:background="@drawable/bg_test_card" android:gravity="center" android:text="PTE" android:textColor="#09899A" android:textSize="27sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_weight="1" android:orientation="vertical">
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PTE Academic" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold"/>
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Pearson Test of English Academic\nComputer-based English language\nproficiency test." android:textColor="#FFFFFF" android:textSize="13sp"/>
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_badge_green" android:paddingLeft="9dp" android:paddingTop="4dp" android:paddingRight="9dp" android:paddingBottom="4dp" android:text="Fast Results" android:textColor="#FFFFFF" android:textSize="11sp"/>
    </LinearLayout>
   </LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center" android:text="◷  Duration        ?  Questions        ▥  Sections        ☆  Accepted in\n   2h 15m                 20+                       4                 85+ Countries" android:textColor="#FFFFFF" android:textSize="12sp"/>
  </LinearLayout>

  <LinearLayout style="@style/IeltsSectionCard">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="About PTE Academic" android:textColor="#071A48" android:textSize="17sp" android:textStyle="bold"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="PTE Academic is a fully computer-based test that assesses your English speaking, writing, reading and listening skills.                                  Read More" android:textColor="#52617C" android:textSize="13sp"/>
  </LinearLayout>

  <LinearLayout style="@style/IeltsSectionCard">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Test Sections                                              View Syllabus" android:textColor="#071A48" android:textSize="16sp" android:textStyle="bold"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:text="🎧 Listening      📖 Reading       🎙 Speaking       ✍ Writing\n  45–57 min          32–41 min          30–35 min          45–57 min" android:textColor="#071A48" android:textSize="12sp"/>
  </LinearLayout>

  <LinearLayout style="@style/IeltsSectionCard">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your Preparation Progress                         View Progress" android:textColor="#071A48" android:textSize="16sp" android:textStyle="bold"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:text="Overall Progress                                                        42%" android:textColor="#071A48" android:textSize="14sp"/>
   <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:max="100" android:progress="42" android:progressTint="#078A99"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="Listening 45%        Reading 35%        Speaking 40%        Writing 50%" android:textColor="#52617C" android:textSize="12sp"/>
  </LinearLayout>

  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:layout_marginStart="4dp" android:text="Study Tools" android:textColor="#071A48" android:textSize="17sp" android:textStyle="bold"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView style="@style/ToolTile" android:text="📄  Study Material\nNotes, PDFs &amp; Tips"/><TextView style="@style/ToolTile" android:text="▶  Video Lessons\nExpert Lectures"/><TextView style="@style/ToolTile" android:text="▣ Practice Questions\nTopic-wise MCQs"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView style="@style/ToolTile" android:text="▦  Mock Tests\nFull length tests"/><TextView style="@style/ToolTile" android:text="🎙 AI Speaking Practice\nPractice &amp; get score"/><TextView style="@style/ToolTile" android:text="✎  AI Writing Evaluator\nCheck your essays"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView style="@style/ToolTile" android:text="Aa Vocabulary Builder\nBuild your words"/><TextView style="@style/ToolTile" android:text="📈 Score Predictor\nPredict your score"/><Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/></LinearLayout>
  <Button android:id="@+id/btnStartPreparing" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="24dp" android:layout_marginBottom="18dp" android:background="@drawable/bg_teal_button" android:text="Start Preparing Now   →" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="17sp"/>
 </LinearLayout>
</ScrollView>
