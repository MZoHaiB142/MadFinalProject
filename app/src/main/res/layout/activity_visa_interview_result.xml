<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FBFCFF" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<RelativeLayout android:layout_width="match_parent" android:layout_height="54dp"><ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:layout_centerVertical="true" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Back" android:padding="12dp" android:src="@drawable/ic_arrow_back"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Mock Interview Result" android:textColor="#071A48" android:textSize="18sp" android:textStyle="bold"/></RelativeLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="135dp" android:layout_marginTop="8dp" android:background="@drawable/bg_result_success" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Great Job!" android:textColor="#35149A" android:textSize="21sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Your answers were evaluated successfully." android:textColor="#52617C" android:textSize="12sp"/></LinearLayout><TextView android:id="@+id/overallScore" android:layout_width="92dp" android:layout_height="92dp" android:background="@drawable/bg_band_ring" android:gravity="center" android:text="0\n/100" android:textColor="#071A48" android:textSize="17sp" android:textStyle="bold"/></LinearLayout>
<TextView style="@style/PrepSectionTitle" android:text="Performance Overview"/><LinearLayout android:layout_width="match_parent" android:layout_height="105dp" android:orientation="horizontal"><TextView android:id="@+id/grammarScore" style="@style/ResultMetric" android:text="Grammar\n\n0" android:textColor="#168C48"/><TextView android:id="@+id/contentScore" style="@style/ResultMetric" android:text="Content\n\n0" android:textColor="#176CC7"/><TextView android:id="@+id/confidenceScore" style="@style/ResultMetric" android:text="Confidence\n\n0" android:textColor="#6841D8"/><TextView android:id="@+id/fluencyScore" style="@style/ResultMetric" android:text="Fluency\n\n0" android:textColor="#EF6C00"/></LinearLayout>
<TextView style="@style/PrepSectionTitle" android:text="Keyword Coverage"/><TextView android:id="@+id/keywordSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_test_card" android:padding="14dp" android:textColor="#243453" android:textSize="13sp"/>
<TextView style="@style/PrepSectionTitle" android:text="Feedback"/><TextView android:id="@+id/feedbackText" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_test_card" android:padding="14dp" android:textColor="#243453" android:textSize="13sp"/>
<TextView android:id="@+id/riskWarning" style="@style/PrepSectionTitle" android:textColor="#E62031" android:visibility="gone"/>
<TextView style="@style/PrepSectionTitle" android:text="Improved Answer"/><TextView android:id="@+id/improvedAnswer" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_test_card" android:padding="14dp" android:textColor="#243453" android:textSize="13sp"/>
<TextView style="@style/PrepSectionTitle" android:text="AI Coach"/><TextView android:id="@+id/reportInsights" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_test_card" android:padding="14dp" android:textColor="#243453" android:textSize="13sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:orientation="horizontal"><Button android:id="@+id/btnDownloadReport" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Download PDF" android:textAllCaps="false"/><Button android:id="@+id/btnShareReport" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Share" android:textAllCaps="false"/><Button android:id="@+id/btnPrintReport" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Print" android:textAllCaps="false"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="20dp" android:orientation="horizontal"><Button android:id="@+id/btnReviewAnswers" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_btn_outline" android:text="Review Answers" android:textAllCaps="false" android:textColor="#5B35DD"/><Button android:id="@+id/btnHome" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_purple_button" android:text="Home" android:textAllCaps="false" android:textColor="#FFFFFF"/></LinearLayout>
</LinearLayout></ScrollView>
