<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFBFE"
    android:orientation="vertical"
    android:padding="14dp">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="54dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="42dp" android:layout_height="42dp" android:layout_centerVertical="true" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Back" android:padding="11dp" android:src="@drawable/ic_arrow_back"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Match the Words" android:textColor="#071A48" android:textSize="17sp" android:textStyle="bold"/>
    </RelativeLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Match each word with its synonym" android:textColor="#17294D" android:textSize="15sp" android:textStyle="bold"/>
    <TextView android:id="@+id/matchStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Select a word, then select its match." android:textColor="#748096" android:textSize="11sp"/>
    <ProgressBar android:id="@+id/matchProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="12dp" android:max="100" android:progress="0" android:progressTint="#6D4CEB" android:progressBackgroundTint="#E6E2F8"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="18dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/leftMatches" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="7dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical"/>
        <LinearLayout android:id="@+id/rightMatches" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="7dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical"/>
    </LinearLayout>
    <Button android:id="@+id/btnRestart" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_purple_button" android:text="Restart Match" android:textAllCaps="false" android:textColor="#FFFFFF"/>
    <ProgressBar android:id="@+id/loading" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center_horizontal" android:indeterminateTint="#5B35DD"/>
</LinearLayout>
