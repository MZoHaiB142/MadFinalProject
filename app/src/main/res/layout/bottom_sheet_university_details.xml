<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<ImageView android:id="@+id/detailImage" android:layout_width="match_parent" android:layout_height="190dp" android:contentDescription="University image" android:scaleType="centerCrop" android:src="@drawable/img"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:id="@+id/detailName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#071A48" android:textSize="22sp" android:textStyle="bold"/>
<TextView android:id="@+id/detailLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#6B7280"/>
<TextView android:id="@+id/detailStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_test_card" android:lineSpacingExtra="5dp" android:padding="14dp" android:textColor="#243453"/>
<TextView android:id="@+id/detailTags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#5B35DD" android:textSize="12sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Programs" android:textColor="#071A48" android:textSize="18sp" android:textStyle="bold"/>
<TextView android:id="@+id/emptyPrograms" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="No program details are currently available." android:textColor="#6B7280" android:visibility="gone"/>
<LinearLayout android:id="@+id/programContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"/>
<Button android:id="@+id/btnCloseDetails" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_button_blue" android:text="Close" android:textAllCaps="false" android:textColor="#FFFFFF"/>
</LinearLayout></LinearLayout></androidx.core.widget.NestedScrollView>
