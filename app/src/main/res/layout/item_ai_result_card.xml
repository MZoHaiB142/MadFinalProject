<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_step_card"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_country"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="CA Canada"
        android:textColor="#94A3B8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btn_top_pick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Top Pick"
        android:textColor="#FFD700"
        android:background="#20FFD700"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_uni_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="University of Toronto"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_country"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/score_ring" />

    <TextView
        android:id="@+id/tv_course"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="MS Computer Science"
        android:textColor="#94A3B8"
        app:layout_constraintTop_toBottomOf="@id/tv_uni_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/score_ring" />

    <com.example.madfinalproject.views.ScoreRingView
        android:id="@+id/score_ring"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="@id/tv_uni_name"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/metrics_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_course">

        <include android:id="@+id/layout_visa" layout="@layout/item_metric_bar" />
        <include android:id="@+id/layout_accept" layout="@layout/item_metric_bar" />
        <include android:id="@+id/layout_gpa" layout="@layout/item_metric_bar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/badges_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/metrics_layout">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top Pick"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_badge"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Pick"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_badge"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scholarship"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_badge"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginEnd="8dp" />
    </LinearLayout>
    <Button
        android:id="@+id/btn_apply"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Apply Here"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/badges_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>
