<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- â”€â”€ Profile Photo + Online Dot â”€â”€ -->
    <FrameLayout
        android:id="@+id/photoFrame"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Circular photo -->
        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_circle_gray"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_university" />

        <!-- Green online dot â€” image jaisa bottom right -->
        <View
            android:id="@+id/ivOnlineDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_online_dot_white_border"
            android:layout_gravity="bottom|end"
            android:visibility="invisible" />

    </FrameLayout>

    <!-- â”€â”€ Name â”€â”€ -->
    <TextView
        android:id="@+id/tvConsultantName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ayesha Malik"
        android:textColor="#1A1A2E"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintStart_toEndOf="@id/photoFrame"
        app:layout_constraintEnd_toStartOf="@id/tvTime"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvExpertise" />

    <!-- â”€â”€ Expertise (colored â€” image jaisa) â”€â”€ -->
    <TextView
        android:id="@+id/tvExpertise"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="USA &amp; Canada Expert"
        android:textColor="#1976D2"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/photoFrame"
        app:layout_constraintEnd_toStartOf="@id/tvTime"
        app:layout_constraintTop_toBottomOf="@id/tvConsultantName"
        app:layout_constraintBottom_toTopOf="@id/tvLastMessage" />

    <!-- â”€â”€ Last Message â”€â”€ -->
    <TextView
        android:id="@+id/tvLastMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Yes, you should definitely apply..."
        android:textColor="#888888"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="1dp"
        app:layout_constraintStart_toEndOf="@id/photoFrame"
        app:layout_constraintEnd_toStartOf="@id/tvUnreadCount"
        app:layout_constraintTop_toBottomOf="@id/tvExpertise"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- â”€â”€ Time (top right) â”€â”€ -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2m"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvConsultantName"
        app:layout_constraintBottom_toBottomOf="@id/tvConsultantName" />

    <!-- â”€â”€ Unread Badge (bottom right â€” image jaisa blue circle) â”€â”€ -->
    <TextView
        android:id="@+id/tvUnreadCount"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:text="2"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_unread_badge_blue"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvLastMessage"
        app:layout_constraintBottom_toBottomOf="@id/tvLastMessage" />

    <!-- â”€â”€ Bottom divider â”€â”€ -->
    <View
        android:layout_width="0dp"
        android:layout_height="0.6dp"
        android:background="#F0F0F0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/photoFrame"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="14dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
