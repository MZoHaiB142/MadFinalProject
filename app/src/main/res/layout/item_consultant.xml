<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- â”€â”€ Profile Photo + Online Dot â”€â”€ -->
    <FrameLayout
        android:id="@+id/photoFrame"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivConsultantProfile"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_circle_gray"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_university" />

        <View
            android:id="@+id/viewStatus"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_online_dot_white_border"
            android:layout_gravity="bottom|end" />
    </FrameLayout>

    <!-- â”€â”€ Name â”€â”€ -->
    <!-- â”€â”€ Name â”€â”€ -->
    <TextView
        android:id="@+id/tvConsultantName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ayesha Malik"
        android:textColor="#1A1A2E"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintStart_toEndOf="@id/photoFrame"
        app:layout_constraintEnd_toStartOf="@id/btnChat"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvExpertise"
        app:layout_constraintVertical_chainStyle="packed" /> <!-- ðŸ”¥ Yahan fix kiya hai -->
    <!-- â”€â”€ Expertise (Blue Color) â”€â”€ -->
    <TextView
        android:id="@+id/tvExpertise"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="USA &amp; Canada Expert"
        android:textColor="#1976D2"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintStart_toEndOf="@id/photoFrame"
        app:layout_constraintEnd_toStartOf="@id/btnChat"
        app:layout_constraintTop_toBottomOf="@id/tvConsultantName"
        app:layout_constraintBottom_toTopOf="@id/tvRating" />

    <!-- â”€â”€ Rating (Grey Text) â”€â”€ -->
    <TextView
        android:id="@+id/tvRating"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="4.8 Rating"
        android:textColor="#888888"
        android:textSize="13sp"
        android:maxLines="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/photoFrame"
        app:layout_constraintEnd_toStartOf="@id/btnChat"
        app:layout_constraintTop_toBottomOf="@id/tvExpertise"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- â”€â”€ Sleek Action Buttons (Right Side) â”€â”€ -->
    <ImageButton
        android:id="@+id/btnCall"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/stat_sys_phone_call"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:tint="#1976D2" />

    <ImageButton
        android:id="@+id/btnChat"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/stat_notify_chat"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@id/btnCall"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:tint="#1976D2" />

    <!-- â”€â”€ Bottom Divider â”€â”€ -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/photoFrame"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="14dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
