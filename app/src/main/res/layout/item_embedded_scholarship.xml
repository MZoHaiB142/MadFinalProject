<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="@drawable/bg_test_card" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/scholarshipTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#071A48" android:textSize="16sp" android:textStyle="bold"/><TextView android:id="@+id/embeddedFavorite" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="♡" android:textColor="#E62031" android:textSize="24sp"/></LinearLayout>
<TextView android:id="@+id/scholarshipAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#168C48" android:textStyle="bold"/>
<TextView android:id="@+id/scholarshipDeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#E65100"/>
<TextView android:id="@+id/scholarshipEligibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#52617C" android:textSize="13sp"/>
<TextView android:id="@+id/scholarshipLink" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_gravity="end" android:layout_marginTop="8dp" android:gravity="center" android:paddingHorizontal="12dp" android:text="Open Scholarship  →" android:textColor="#2962FF" android:textStyle="bold"/>
</LinearLayout>
