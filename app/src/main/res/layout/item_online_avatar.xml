<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_marginEnd="14dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Photo + green ring -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp">

        <!-- Green ring border -->
        <View
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_online_ring"
            android:layout_gravity="center" />

        <!-- Photo -->
        <ImageView
            android:id="@+id/ivAvatarPhoto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_logo_circle"
            android:scaleType="centerCrop"
            android:layout_gravity="center"
            android:src="@drawable/ic_university" />

        <!-- Live dot -->
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_online_dot"
            android:layout_gravity="bottom|end" />
    </FrameLayout>

    <!-- Name -->
    <TextView
        android:id="@+id/tvAvatarName"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:text="Ayesha"
        android:textColor="#1A1A2E"
        android:textSize="10sp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="4dp" />

</LinearLayout>
