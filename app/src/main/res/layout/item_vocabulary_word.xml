<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    android:background="@drawable/bg_test_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="70dp"
    android:orientation="horizontal"
    android:padding="10dp">

    <TextView
        android:id="@+id/btnWordSpeak"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_vocabulary_soft"
        android:gravity="center"
        android:text="🔊"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wordTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#17294D"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wordMeaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:textColor="#748096"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/wordProgress"
        android:layout_width="48dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="0%"
        android:textColor="#7C3AED"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="›"
        android:textColor="#5B35DD"
        android:textSize="24sp" />
</LinearLayout>
