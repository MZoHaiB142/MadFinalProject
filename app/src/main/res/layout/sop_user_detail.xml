<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <!-- â”€â”€ Top Bar â”€â”€ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_profile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/user_profile"
            android:background="@drawable/bg_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AbroadIQ"
            android:textColor="#1A1A2E"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/iv_profile"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/iv_bell"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/notification"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- â”€â”€ Step Progress Indicator â”€â”€ -->
    <LinearLayout
        android:id="@+id/step_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="01"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_step_done" />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#4A6CF7" />

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="02"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_step_done" />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#4A6CF7" />

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="03"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_step_active" />
    </LinearLayout>

    <!-- â”€â”€ Scrollable Form Content â”€â”€ -->
    <ScrollView
        android:id="@+id/scroll_form"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/step_indicator"
        app:layout_constraintBottom_toTopOf="@id/btn_generate">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp">

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Final Profile Details"
                android:textColor="#1A1A2E"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 3: Missing these details can lead to visa rejection."
                android:textColor="#D32F2F"
                android:textSize="12sp"
                android:layout_marginBottom="20dp" />

            <!-- ========================================== -->
            <!-- CARD 1: Academic & Target Info -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_form_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Academic Profile"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Target Program & Country Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target Program"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#555555"
                            android:layout_marginBottom="4dp" />
                        <EditText
                            android:id="@+id/et_target_program"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:hint="MS Computer Science"
                            android:textSize="13sp"
                            android:background="@drawable/bg_input_field"
                            android:paddingStart="12dp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target Country"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#555555"
                            android:layout_marginBottom="4dp" />
                        <EditText
                            android:id="@+id/et_target_country"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:hint="Australia"
                            android:textSize="13sp"
                            android:background="@drawable/bg_input_field"
                            android:paddingStart="12dp"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- FYP / Main Project (Crucial for AI rules) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Main Project / FYP Title"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#555555"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/et_main_project"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:hint="E.g., Built an AI-driven educational platform (AbroadIQ) using Python..."
                    android:textSize="13sp"
                    android:background="@drawable/bg_input_field"
                    android:padding="12dp"
                    android:gravity="top"
                    android:inputType="textMultiLine" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Subjects of your Future Master's Degree"
                app:helperText="Tip: Mentioning 2-3 subjects (e.g., Machine Learning, Big Data) proves your research to the Visa Officer."
                app:helperTextTextColor="#00796B"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/black"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etKeySubjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/black" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Previous Education (e.g., BS Information Technology)"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPreviousEducation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/black" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ========================================== -->
            <!-- CARD 2: Experience & Financials -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_form_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Experience &amp; Finances"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Work Experience Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Do you have work experience?"
                        android:textSize="13sp"
                        android:textColor="#1A1A2E" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_work_exp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Job Details (Default Gone, show in Java if switch is ON) -->
                <EditText
                    android:id="@+id/et_work_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:hint="Company name, Job Title, and Skills learned..."
                    android:textSize="13sp"
                    android:background="@drawable/bg_input_field"
                    android:padding="12dp"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="12dp"
                    android:layout_marginTop="4dp"/>

                <!-- Sponsor Details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sponsor Relation"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#555555"
                            android:layout_marginBottom="4dp" />
                        <EditText
                            android:id="@+id/et_sponsor_relation"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:hint="E.g., Father"
                            android:textSize="13sp"
                            android:background="@drawable/bg_input_field"
                            android:paddingStart="12dp"
                            android:singleLine="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sponsor Profession"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#555555"
                            android:layout_marginBottom="4dp" />
                        <EditText
                            android:id="@+id/et_sponsor_profession"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:hint="E.g., Govt Officer"
                            android:textSize="13sp"
                            android:background="@drawable/bg_input_field"
                            android:paddingStart="12dp"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ========================================== -->
            <!-- CARD 3: Return Intent & Future Goals -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_form_card"
                android:padding="16dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Return Intent (Crucial)"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Target Industry Chips -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target Industry in Pakistan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#555555"
                    android:layout_marginBottom="8dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Apne purane 'Ask Question' wale tags ka drawable yahan lagayen -->
                        <TextView
                            android:id="@+id/tag_software"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Software Houses"
                            android:textColor="#4B5563"
                            android:background="@drawable/bg_tag_unselected"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tag_fintech"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FinTech"
                            android:textColor="#4B5563"
                            android:background="@drawable/bg_tag_unselected"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tag_ai"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI Startups"
                            android:textColor="#4B5563"
                            android:background="@drawable/bg_tag_unselected"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tag_telecom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Telecom"
                            android:textColor="#4B5563"
                            android:background="@drawable/bg_tag_unselected"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Career Goals -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Long-term Career Goal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#555555"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/et_career_goals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="70dp"
                    android:hint="E.g., I plan to return and start my own software house in Lahore to solve local business problems..."
                    android:textSize="13sp"
                    android:background="@drawable/bg_input_field"
                    android:padding="12dp"
                    android:gravity="top"
                    android:inputType="textMultiLine" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- â”€â”€ Generate SOP Button â”€â”€ -->
    <Button
        android:id="@+id/btn_generate"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Generate SOP"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_generate_button"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
